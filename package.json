{
  "name": "uikit",
  "version": "0.1.3",
  "private": true,
  "description": "uikit system monorepo",
  "scripts": {
    "build": "pnpm -r run build",
    "type-check": "pnpm -r run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dev:test-app": "pnpm --filter @flex/uikit-test dev",
    "build:test-app": "pnpm --filter @flex/uikit-test build"
  },
  "dependencies": {
    "@flex/uikit": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-essentials": "^8.5.8",
    "@storybook/react": "^8.5.8",
    "@storybook/react-vite": "^8.5.8",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-file-extension-in-import-ts": "^2.1.0",
    "eslint-plugin-import": "2.29.1",
    "prettier": "^3.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "^8.5.8",
    "storybook-dark-mode": "^4.0.2",
    "tsx": "^4.16.3",
    "typescript": "^5.4.2",
    "vite": "^6.1.1"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.18",
      "@types/react-dom": "18.3.5"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "@tabler/icons-react"
      ]
    }
  },
  "engines": {
    "node": ">= 20",
    "pnpm": ">= 8"
  },
  "packageManager": "pnpm@10.30.0"
}
