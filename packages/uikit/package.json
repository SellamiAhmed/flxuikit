{
  "name": "@flxui/uikit",
  "version": "0.8.1",
  "description": "system UI kit built on Mantine v7",
  "repository": {
  "type": "git",
  "url": "https://github.com/SellamiAhmed/flxuikit",
  "directory": "packages/uikit"
},
  "type": "module",
  "main": "dist/primitive/index.cjs",
  "module": "dist/primitive/index.mjs",
  "types": "dist/primitive/index.d.ts",
  "scripts": {
    "build": "vite build && tsx scripts/verify-dist.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/primitive/index.d.mts",
      "import": "./dist/primitive/index.mjs",
      "require": "./dist/primitive/index.cjs"
    },
    "./business": {
      "types": "./dist/business/index.d.mts",
      "import": "./dist/business/index.mjs",
      "require": "./dist/business/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.mts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.mts",
      "import": "./dist/theme/index.mjs",
      "require": "./dist/theme/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.mts",
      "import": "./dist/icons/index.mjs",
      "require": "./dist/icons/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "dist/styles.css",
    "dist/styles.cjs.css",
    "**/utils/dayjs.mjs",
    "**/utils/dayjs.cjs"
  ],
  "dependencies": {
    "@hookform/error-message": "^2.0.1",
    "@tabler/icons-react": "^3.26.0",
    "ahooks": "^3.9.7",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.5",
    "dompurify": "^3.4.12",
    "embla-carousel-react": "^7.0.5",
    "google-libphonenumber": "^3.2.30",
    "lodash-es": "^4.17.21",
    "pretty-ms": "^9.3.0",
    "react-phone-input-2": "^2.15.1",
    "react-table": "^7.8.0",
    "react-table-sticky": "^1.1.3",
    "react-textarea-autosize": "8.5.6",
    "react-window": "^1.8.9"
  },
  "peerDependencies": {
    "@mantine/carousel": "^7.17.8",
    "@mantine/code-highlight": "^7.17.8",
    "@mantine/core": "^7.17.8",
    "@mantine/dates": "^7.17.8",
    "@mantine/dropzone": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "react": "^18.x || ^19.x",
    "react-dom": "^18.x || ^19.x",
    "react-hook-form": "^7.51.5"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mantine/carousel": "7.17.8",
    "@mantine/code-highlight": "7.17.8",
    "@mantine/core": "7.17.8",
    "@mantine/dates": "7.17.8",
    "@mantine/dropzone": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "@mantine/modals": "7.17.8",
    "@mantine/notifications": "7.17.8",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/google-libphonenumber": "^7.4.23",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-table": "^7.7.12",
    "@types/react-window": "^1.8.5",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^30.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.51.5",
    "tsx": "^4.23.0",
    "typescript": "^5.4.2",
    "vite": "^6.1.1",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
