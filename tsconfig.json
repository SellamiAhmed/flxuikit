{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "sourceMap": true,
    "allowJs": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@flxui/uikit": ["packages/uikit/src/primitive"],
      "@flxui/uikit/theme": ["packages/uikit/src/theme"],
      "@flxui/uikit/business": ["packages/uikit/src/business"],
      "@flxui/uikit/hooks": ["packages/uikit/src/hooks"],
      "@flxui/uikit/utils": ["packages/uikit/src/utils"]
    }
  },
  "exclude": ["node_modules", "dist"],

}
